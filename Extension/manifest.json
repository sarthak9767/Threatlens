{
  "manifest_version": 3,
  "name": "Threat Lens Prototype",
  "version": "1.1.0",
  "description": "Analyze one open email or 5-25 selected Gmail emails in a consolidated forensic report.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Threat Lens Prototype",
    "default_popup": "popup/popup.html"
  }
}
